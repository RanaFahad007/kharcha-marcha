# SplitTrack server — copy to .env and fill in real values. Never commit .env.
PORT=5000
MONGO_URI=mongodb://localhost:27017/splittrack
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Frontend origin allowed by CORS (your deployed Vercel URL, or http://localhost:5173 for local dev)
FRONTEND_URL=http://localhost:5173
# Base URL of this API, as the Vite client calls it (used by CORS allow-list)
VITE_API_URL=http://localhost:5000
